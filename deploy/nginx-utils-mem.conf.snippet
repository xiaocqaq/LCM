# ===== memorys 知识库（新增段，整段可删除回退）=====
# 挂在 utils.xlingo.fun/mem/ 下。前端 index.html 会自动侦测 /mem 前缀并给 API 请求加回来。
# 必须用 ^~ 前缀匹配：本 vhost 底部有宝塔生成的 location ~ .*\.(js|css)?$ 正则块，
# 正则优先级高于普通前缀 location，不加 ^~ 会被正则块截走静态资源。

location = /mem {
    return 301 /mem/;
}

location ^~ /mem/ {
    proxy_pass http://127.0.0.1:8649/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # MCP streamable HTTP 是 SSE 长连接：必须关缓冲，否则 agent 收不到流式响应
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    chunked_transfer_encoding on;

    client_max_body_size 20m;
}
# ===== memorys 知识库结束 =====
