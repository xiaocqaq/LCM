# ===== memorys 配置模板 =====
# 复制为 .env 并填写。.env 不进 git（见 .gitignore）。
# 环境变量前缀统一为 MEM_，同名环境变量优先级高于本文件。

# ---- 必填 ----

# PostgreSQL 连接串。需要 pgvector 与 pg_trgm 扩展。
# 建库示例：
#   CREATE DATABASE memorys;
#   \c memorys
#   CREATE EXTENSION IF NOT EXISTS vector;
#   CREATE EXTENSION IF NOT EXISTS pg_trgm;
MEM_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/memorys

# JWT 签名密钥。至少 32 字符，用 `openssl rand -hex 32` 生成。
# 若要复用已有站点的账号体系（见 MEM_UPSTREAM_BASE），必须与那边用同一个值 ——
# 本服务据此验签上游签发的 token。
MEM_JWT_SECRET=

# ---- 存储 ----

# md 文件与每用户 git 仓库的根目录。这是 source of truth，PG 只是索引。
MEM_DATA_DIR=/var/lib/memorys

# ---- 账号体系（可选）----

# 复用外部站点登录：POST /api/v1/auth/ai-login 会把凭据转发到
# {MEM_UPSTREAM_BASE}/api/v1/auth/login，成功后按上游 user id 建本地账号。
# 留空则只能用 API Key 认证。
MEM_UPSTREAM_BASE=

# 本地签发 token 的有效期（分钟）
MEM_ACCESS_TTL_MINUTES=720

# ---- 向量检索（可选）----

# 留空则自动降级为「jieba 分词 tsvector + pg_trgm」两路检索，功能完整可用。
# 填了就启用三路 RRF 融合。任意 OpenAI 兼容 /embeddings 端点均可。
#
# 阿里云百炼示例（实测：返回 1024 维，批量上限 25）：
#   MEM_EMBED_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
#   MEM_EMBED_MODEL=text-embedding-v4
#   MEM_EMBED_DIM=1024
#   MEM_EMBED_BATCH_SIZE=25
#
# OpenAI 示例：
#   MEM_EMBED_API_BASE=https://api.openai.com/v1
#   MEM_EMBED_MODEL=text-embedding-3-small
#   MEM_EMBED_DIM=1536
MEM_EMBED_API_BASE=
MEM_EMBED_API_KEY=
MEM_EMBED_MODEL=text-embedding-3-small

# ⚠️ 必须与上游实际返回的维度一致。hnsw 索引建在固定维度的表达式上，
# 填错不会报错而是索引静默失效（退化成全表扫描）。改这个值要重启并全量 reindex。
MEM_EMBED_DIM=1536

# 单次请求最多几条文本。超过上游上限会整批失败。
MEM_EMBED_BATCH_SIZE=25
# 写入侧超时（秒）。reindex 是后台批处理，可以慢，值得等重试。
MEM_EMBED_TIMEOUT=30
# 查询侧硬预算（秒）。检索是交互路径，超了直接降级成两路，不让用户干等。
MEM_EMBED_QUERY_TIMEOUT=4
# 单条文本截断长度，控制 token 消耗
MEM_EMBED_MAX_CHARS=2500

# ---- GitHub 备份（可选）----

# 每用户的 md 仓库推到这里。留空则只做本地 git 提交不推远端。
#   带 {uid} 占位符 → 一人一仓：git@github.com:you/memorys-{uid}.git
#   不带占位符     → 共用一仓，按 u<uid> 分支隔离
MEM_GITHUB_REMOTE=
MEM_SYNC_BRANCH=main
MEM_SYNC_IDENTITY_NAME=memorys-bot
MEM_SYNC_IDENTITY_EMAIL=memorys@example.com

# ---- 监听与反代 ----

MEM_APP_HOST=127.0.0.1
MEM_APP_PORT=8649

# 反代子路径前缀。nginx 若把 /mem/ strip 掉再转发，这里填 /mem，
# 否则 /api/docs 里的 openapi.json 会去宿主站根目录取而 404。
# 直接挂域名根时留空。
MEM_ROOT_PATH=

# MCP 的 DNS rebinding 防护白名单。后端只听 127.0.0.1，FastMCP 默认只放行本机 Host；
# 经 nginx 进来的 Host 是真实域名，不在这里放行会返回 421。
# 逗号分隔，支持 host:* 通配。
MEM_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*,your-domain.example.com
